party <- c(rep("A", 5), rep("B", 7))
xparty <- ifelse(party == "A", 0.5, 1.5)
prop <- rnorm(12, 7, 2)
plot.new()
plot.window(c(0.5, 2.5), c(0, 10))
points(x = xparty, y = prop, col=c("red", "blue"), pch=21)
axis(1, at=xparty, labels=party) 
box()